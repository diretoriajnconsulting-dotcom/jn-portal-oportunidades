{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ponteprojetos.example/schemas/oportunidades-1.0.json",
  "title": "Painel de oportunidades — Transferegov Discricionárias",
  "type": "object",
  "required": ["versao", "gerado_em", "uf", "origem", "resumo", "filtros",
               "oportunidades", "propostas_recentes", "encerradas"],
  "additionalProperties": true,
  "properties": {
    "versao": {
      "type": "string", "pattern": "^\\d+\\.\\d+$",
      "description": "Semver reduzido. Major diferente = contrato incompatível: o front deve recusar a renderização."
    },
    "gerado_em": { "type": "string", "description": "ISO 8601, hora local da geração." },
    "uf": { "type": "string", "minLength": 2, "maxLength": 2 },

    "origem": {
      "type": "object",
      "required": ["repositorio", "modulo", "atualizada_em", "defasagem_dias", "defasada"],
      "properties": {
        "repositorio": { "type": "string", "format": "uri" },
        "modulo": { "type": "string" },
        "atualizada_em": {
          "type": ["string", "null"],
          "description": "Last-Modified mais recente entre os arquivos de origem."
        },
        "defasagem_dias": { "type": ["integer", "null"], "minimum": 0 },
        "defasada": {
          "type": "boolean",
          "description": "true quando defasagem_dias > 3. Quando true, o site É OBRIGADO a exibir o aviso: ausência de novidade pode ser coleta parada na origem, não ausência de fato."
        }
      }
    },

    "resumo": {
      "type": "object",
      "description": "Totais já calculados. O front não deve recontar.",
      "required": ["abertas", "urgentes", "aderentes", "novas",
                   "propostas_recentes", "encerradas"],
      "properties": {
        "abertas": { "type": "integer", "minimum": 0 },
        "urgentes": { "type": "integer", "minimum": 0 },
        "aderentes": { "type": "integer", "minimum": 0 },
        "novas": { "type": "integer", "minimum": 0 },
        "propostas_recentes": { "type": "integer", "minimum": 0 },
        "encerradas": { "type": "integer", "minimum": 0 }
      }
    },

    "filtros": {
      "type": "object",
      "description": "Eixos de filtro prontos, ordenados por frequência. O front não deve derivá-los do array.",
      "required": ["naturezas", "canais", "orgaos"],
      "properties": {
        "naturezas": { "type": "array", "items": { "type": "string" } },
        "canais": { "type": "array", "items": { "enum": ["proposta", "emenda"] } },
        "orgaos": { "type": "array", "items": { "type": "string" } }
      }
    },

    "oportunidades": {
      "type": "array",
      "description": "Ordenado por dias_restantes e, no empate, por programa.",
      "items": {
        "type": "object",
        "required": ["id", "programa", "orgao", "natureza", "canal", "fecha",
                     "dias_restantes", "urgente", "nova", "aderente",
                     "temas", "codigos", "propostas_recebidas"],
        "properties": {
          "id": {
            "type": "string", "minLength": 12, "maxLength": 12,
            "description": "Estável entre execuções. Use como key de lista e âncora de deep link."
          },
          "programa": { "type": "string" },
          "orgao": { "type": "string", "description": "Vem em caixa alta da origem; não normalizar." },
          "natureza": {
            "type": "string",
            "description": "Quem pode se candidatar. Eixo primário de filtro."
          },
          "canal": {
            "enum": ["proposta", "emenda"],
            "description": "Janelas distintas. O mesmo programa pode aparecer duas vezes, uma por canal — NÃO deduplicar."
          },
          "modalidade": { "type": ["string", "null"] },
          "situacao": { "type": ["string", "null"], "examples": ["DISPONIBILIZADO", "CADASTRADO"] },
          "abre": { "type": ["string", "null"], "format": "date" },
          "fecha": { "type": ["string", "null"], "format": "date" },
          "dias_restantes": { "type": ["integer", "null"], "minimum": 0 },
          "urgente": {
            "type": "boolean",
            "description": "dias_restantes <= 15, calculado na geração. Não recalcular no cliente."
          },
          "nova": { "type": "boolean", "description": "Apareceu desde a execução anterior." },
          "aderente": { "type": "boolean" },
          "temas": { "type": "array", "items": { "type": "string" } },
          "codigos": {
            "type": "array", "items": { "type": "string" }, "minItems": 1,
            "description": "Um COD_PROGRAMA por ação orçamentária. Com mais de um, exibir a contagem."
          },
          "propostas_recebidas": {
            "type": "integer", "minimum": 0,
            "description": "Leitura de concorrência. Zero é informação, não ausência de dado."
          }
        }
      }
    },

    "propostas_recentes": {
      "type": "array",
      "description": "Pode ser vazio: só se popula quando há execução anterior para comparar.",
      "items": {
        "type": "object",
        "required": ["data", "programa", "proponente", "uf", "mesma_uf"],
        "properties": {
          "data": { "type": ["string", "null"], "format": "date" },
          "programa": { "type": "string" },
          "proponente": { "type": ["string", "null"] },
          "municipio": { "type": ["string", "null"] },
          "uf": { "type": ["string", "null"] },
          "natureza": { "type": ["string", "null"] },
          "situacao": { "type": ["string", "null"] },
          "valor_global": {
            "type": ["number", "null"],
            "description": "Reais. Nulo exibe travessão, nunca R$ 0,00."
          },
          "objeto": { "type": ["string", "null"], "description": "Já truncado em 120 caracteres." },
          "mesma_uf": { "type": "boolean", "description": "Concorrência direta — destacar." }
        }
      }
    },

    "encerradas": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Códigos de programa cuja janela fechou desde a execução anterior."
    }
  }
}
